{
  "$schema_note": "One entry per env var. Fields: name, provider, url (where to create the key), steps[], pattern (regex), sensitive (bool), sensitive_pattern (regex: sensitive only if value matches), check {method,url,auth,headers,reject_status[],at_use}, generate. auth: bearer | header:<Name> | prefix:<Scheme> | basic-user | query:<param>. reject_status: extra HTTP statuses that mean the credential was rejected, for providers whose documented auth-failure code is not 401 (403 is not-permitted, never dead: a restricted key is a live key). at_use: the probe may run unattended on every need (free, read-only, 401 unambiguous); off for metered endpoints, generic-400 providers, and body-verdict endpoints.",
  "providers": [
    { "name": "OPENAI_API_KEY", "provider": "OpenAI", "url": "https://platform.openai.com/api-keys", "steps": ["Sign in or create an account", "Create new secret key", "Copy it, because it is shown once"], "pattern": "^sk-", "check": { "url": "https://api.openai.com/v1/models", "auth": "bearer", "at_use": true } },
