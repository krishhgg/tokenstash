    { "name": "XAI_API_KEY", "provider": "xAI", "url": "https://console.x.ai", "steps": ["Sign in", "API Keys → Create", "Copy it"], "pattern": "^xai-", "check": { "url": "https://api.x.ai/v1/models", "auth": "bearer", "reject_status": [400] } },
    { "name": "DEEPSEEK_API_KEY", "provider": "DeepSeek", "url": "https://platform.deepseek.com/api_keys", "steps": ["Sign in", "Create new API key", "Copy it"], "pattern": "^sk-", "check": { "url": "https://api.deepseek.com/models", "auth": "bearer", "at_use": true } },
